# ─── HustVA V3 — Production Environment ──────────────────────────────────────
# Copy file này → .env.production và điền đầy đủ trước khi deploy

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
SERVICE_NAME=HustVA-V3

# ─── HUST eHUST API ───────────────────────────────────────────────────────────
HUST_BASE_API_URL=https://api-dot-hust-edu.appspot.com/partner/api
HUST_API_TOKEN=                         # ← điền token eHUST
HUST_AUTHORIZATION_TOKEN=               # ← Bearer token eHUST
HUST_JSESSIONID=                        # ← session ID eHUST
HUST_API_TIMEOUT=30000
HUST_API_RETRY_COUNT=3
HUST_API_RETRY_DELAY=1000
HUST_DEFAULT_SEMESTER=20252
HUST_DEFAULT_PROGRAM_ID=IT-E15

# ─── LLM — Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=                         # ← Google Gemini API key
GEMINI_MODEL=gemini-2.5-flash
REWRITE_MODEL=gemini-2.0-flash

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Khi dùng docker-compose.production.yml, service name = mongodb
MONGO_URI=mongodb://mongodb:27017/hustva_v3

# ─── Milvus (local — không dùng cloud) ───────────────────────────────────────
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=hust_knowledge

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hustva_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_TTL_SECONDS=3600

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=                             # ← đổi secret mạnh hơn khi production!

# ─── Prompts ──────────────────────────────────────────────────────────────────
PROMPTS_BASE_DIR=src/agent/prompts
PROMPT_INDEX_PATH=src/agent/prompts/index.yaml

# ─── LLM tuning ───────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_FALLBACK_MODELS=gemini-1.5-flash

# ─── Observability (optional) ─────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://us.cloud.langfuse.com
# TRACING_PROVIDER=langfuse
# LANGCHAIN_CALLBACKS_BACKGROUND=false
