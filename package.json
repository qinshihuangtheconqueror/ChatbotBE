{
  "name": "hustva-v3",
  "version": "3.0.0",
  "description": "HustVA V3 — HUST Academic Assistant powered by LangGraph + NestJS",
  "author": "HustVA Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "ts-node -r tsconfig-paths/register src/server/main.ts",
    "start:watch": "nodemon --watch src --ext ts --exec \"ts-node -r tsconfig-paths/register src/server/main.ts\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/server/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "seed:qdrant": "ts-node -r tsconfig-paths/register scripts/seed-qdrant.ts",
    "seed:neo4j": "ts-node -r tsconfig-paths/register scripts/seed-neo4j.ts",
    "seed:milvus": "node scripts/seed-milvus.js",
    "seed:milvus:extra": "cross-env APPEND_ONLY=true DATA_PATH=src/common/data/rag_data_final_new_v2.json node scripts/seed-milvus.js",
    "seed:all": "npm run seed:milvus && npm run seed:milvus:extra"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.1.27",
    "@langchain/google-genai": "^2.1.20",
    "@langchain/langgraph": "^1.1.5",
    "@langchain/langgraph-checkpoint-mongodb": "^1.1.7",
    "@langchain/openai": "^1.4.7",
    "@langfuse/langchain": "^4.6.1",
    "@langfuse/otel": "^4.6.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@opentelemetry/auto-instrumentations-node": "^0.70.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@xenova/transformers": "^2.17.2",
    "@zilliz/milvus2-sdk-node": "^2.6.10",
    "axios": "^1.13.5",
    "axios-retry": "^4.5.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.3.1",
    "ioredis": "^5.6.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "langfuse": "^3.38.6",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.1",
    "neo4j-driver": "^5.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
