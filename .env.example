# ═══════════════════════════════════════════════════════════════════════════════
# HustVA V3 — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SERVICE_NAME=HustVA-V3

# ─── HUST eHUST API (Partner API) ────────────────────────────────────────────
# Credentials for eHUST partner API — used to fetch student grades, schedule, etc.
HUST_BASE_API_URL=https://api-dot-hust-edu.appspot.com/partner/api
HUST_API_TOKEN=<your-hust-partner-api-token>
HUST_AUTHORIZATION_TOKEN=<your-hust-authorization-bearer-token>
HUST_JSESSIONID=
HUST_API_TIMEOUT=30000
HUST_API_RETRY_COUNT=3
HUST_API_RETRY_DELAY=1000
HUST_DEFAULT_SEMESTER=
HUST_DEFAULT_PROGRAM_ID=

# ─── LLM — Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_FALLBACK_MODELS=

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/hustva_v3

# ─── Milvus (Vector Store — thay thế Qdrant) ─────────────────────────────────
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=hust_knowledge

# ─── Embedding (BGE-M3 chạy local — không cần API ngoài) ─────────────────────
EMBEDDING_API_URL=http://localhost:8080

# ─── Neo4j (Graph DB — course prerequisites) ─────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# ─── Redis (Cache + Rate Limiting) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600

# ─── Auth & Security ─────────────────────────────────────────────────────────
# JWT signing secret — dùng chuỗi ngẫu nhiên dài, đổi khác nhau giữa dev/prod
JWT_SECRET=<your-jwt-secret>

# CORS — danh sách domain được phép gọi API (phân cách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:80,http://localhost:3000,http://localhost:8080

# ─── Microsoft OAuth2 (Đăng nhập bằng Email HUST) ────────────────────────────
# Lấy từ Azure Portal → App registrations → your-app
MS_CLIENT_ID=<your-azure-app-client-id>
MS_CLIENT_SECRET=<your-azure-client-secret>
# 'common' = chấp nhận mọi tài khoản Microsoft. Đặt tenant ID cụ thể để chỉ cho HUST.
MS_TENANT_ID=common

# ─── Observability — Langfuse ─────────────────────────────────────────────────
# Đăng ký miễn phí tại https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# 'langfuse' (bật tracing) | 'none' (tắt tracing)
TRACING_PROVIDER=none

# ─── Prompts ──────────────────────────────────────────────────────────────────
PROMPTS_BASE_DIR=src/agent/prompts
PROMPT_INDEX_PATH=src/agent/prompts/index.yaml
